[Unit]
Description=Armature microservice
After=network.target 
Documentation=


[Service]
Type=simple


ExecStart=/usr/java/latest/bin/java -Dserver.port=8084  -jar /opt/SPP/lib/armature-ms.jar


PermissionsStartOnly=true
Restart=always
RestartSec=60
StartLimitInterval=120
StartLimitBurst=2
LimitCORE=infinity

[Install]
WantedBy=multi-user.target

